<div class="tplinksmartplug-controls" data-bind="foreach: arrSmartplugs">
    <div class="well well-small">
        <strong data-bind="text: label"></strong>
        <p class="muted" data-bind="text: $root.plugStateText($data)" aria-live="polite"></p>
        <div class="btn-group">
            <button type="button" class="btn btn-small tplinksmartplug-on" data-bind="click: $root.sidebarTurnOn, enable: $root.canControlPlug($data) && currentState() !== 'on'">{{ _('On') }}</button>
            <button type="button" class="btn btn-small tplinksmartplug-off" data-bind="click: $root.sidebarTurnOff, enable: $root.canControlPlug($data) && currentState() !== 'off'">{{ _('Off') }}</button>
        </div>
    </div>
</div>
<!-- ko if: show_sidebar -->
<div id="tplinksmartplugs" class="row-fluid" data-bind="foreach: filteredSmartplugs">
	<div data-bind="with: value">
		<div class="row-fluid" data-bind="if: emeter.get_realtime.err_code == 0,css: currentState">
			Plug: <strong data-bind="text: label"></strong><br/>
			Current Power: <strong data-bind="text: $root.get_power($data)"></strong> W<br/>
			Total Consumption: <strong data-bind="text: $root.get_kwh($data)"></strong> kWh<br/>
			Cost: <strong data-bind="text: $root.get_cost($data)"></strong>
		</div>
	</div>
</div>
<!-- /ko -->